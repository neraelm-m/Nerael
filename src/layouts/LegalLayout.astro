---
import Layout from "./Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  title: string;
  description: string;
  kicker: string;
  updated: string;
}

const { title, description, kicker, updated } = Astro.props;
---

<Layout title={`${title} · NERAEL`} description={description}>
  <SiteHeader active="home" />

  <main class="legal">
    <header class="legal-head">
      <span class="legal-kicker">{kicker}</span>
      <h1>{title}<span>.</span></h1>
      <p class="legal-updated">Última actualización: {updated}</p>
    </header>

    <article class="legal-body">
      <slot />
    </article>

    <nav class="legal-links" aria-label="Documentos legales">
      <a href="/terminos">Términos y Condiciones</a>
      <a href="/privacidad">Política de Privacidad</a>
      <a href="/">Volver al inicio</a>
    </nav>
  </main>
</Layout>

<style>
  :global(body) {
    margin: 0;
    background: #050505;
    color: #f4f1ef;
    font-family: Arial, Helvetica, sans-serif;
  }

  .legal {
    width: min(820px, calc(100% - 40px));
    margin: 0 auto;
    padding: 150px 0 90px;
  }

  .legal-kicker {
    color: rgba(255, 255, 255, 0.46);
    font: 9px "Courier New", monospace;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .legal-head h1 {
    margin: 14px 0 12px;
    font-size: clamp(44px, 8vw, 84px);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .legal-head h1 span {
    color: #ed233f;
  }

  .legal-updated {
    margin: 0 0 48px;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.55);
    font-size: 13px;
  }

  .legal-body :global(h2) {
    margin: 42px 0 12px;
    font-size: 19px;
    letter-spacing: -0.01em;
  }

  .legal-body :global(p),
  .legal-body :global(li) {
    color: rgba(255, 255, 255, 0.74);
    font-size: 15px;
    line-height: 1.8;
  }

  .legal-body :global(p) {
    margin: 0 0 14px;
  }

  .legal-body :global(ul) {
    margin: 0 0 14px;
    padding-left: 22px;
  }

  .legal-body :global(a) {
    color: #fff;
    text-decoration: underline;
    text-decoration-color: #ed233f;
    text-underline-offset: 3px;
  }

  .legal-body :global(strong) {
    color: #fff;
  }

  .legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    margin-top: 60px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .legal-links a {
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
    text-decoration: none;
  }

  .legal-links a:hover,
  .legal-links a:focus-visible {
    color: #fff;
  }
</style>
