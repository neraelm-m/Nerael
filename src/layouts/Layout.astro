---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "NERAEL · PRØYET_RED",
  description = "David Martinez · Software Developer",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>