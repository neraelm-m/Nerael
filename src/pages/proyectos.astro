---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";

const projects = [
  {
    id: "01",
    title: "ALSACA",
    category: "WEB / MANAGEMENT",
    description:
      "Plataforma web para una alfarería con gestión de inventario, envíos y procesos internos.",
    image: "/assets/demoalsaca/alsaca1.png",
    featured: true,
    href: "https://alsaca-demo.netlify.app/",
    action: "VER PROYECTO",
  },
  {
    id: "02",
    title: "RED MARKET CORE",
    category: "DIGITAL / SYSTEM",
    description:
      "Concepto de plataforma digital con una identidad visual inspirada en sistemas tecnológicos.",
    image: "/assets/images/construccion.png",
    featured: false,
    href: "#",
    action: "VER PROYECTO",
  },
];
---

<Layout
  title="Proyectos · NERAEL"
  description="Proyectos de desarrollo web y sistemas digitales de David Martinez."
>
  <main class="projects-page">
    <!-- =========================================================
         AMBIENT BACKGROUND
    ========================================================== -->
    <div class="ambient" aria-hidden="true">
      <div class="ambient-image ambient-image-one"></div>
      <div class="ambient-image ambient-image-two"></div>
      <div class="ambient-image ambient-image-three"></div>

      <div class="red-orb orb-one"></div>
      <div class="red-orb orb-two"></div>

      <div class="ambient-grid"></div>
      <div class="ambient-noise"></div>
      <div class="ambient-vignette"></div>
    </div>

    <!-- =========================================================
         CURSOR / SCROLL
    ========================================================== -->
    <div class="cursor-light" aria-hidden="true"></div>
    <div class="scroll-progress" aria-hidden="true"></div>

    <SiteHeader active="proyectos" />

    <!-- =========================================================
         PAGE CONTENT
    ========================================================== -->
    <div class="page-content">

      <!-- =======================================================
           INTRO
      ======================================================== -->
      <section class="projects-intro">
        <div class="section-kicker reveal">
          <span class="kicker-line"></span>
          <span>SELECTED WORK / 2026</span>
        </div>

        <div class="intro-grid">
          <div class="intro-title-wrap reveal">
            <p class="intro-index">02 / 05</p>

            <h1>
              PROYECTOS<span>.</span>
            </h1>
          </div>

          <div class="intro-copy reveal reveal-delay">
            <p class="intro-lead">
              Una selección de proyectos de desarrollo web,
              sistemas y experiencias digitales construidas
              con una dirección visual propia.
            </p>

            <p class="intro-small">
              Cada proyecto parte de una necesidad concreta
              y busca convertirla en una solución funcional,
              clara y cuidadosamente construida.
            </p>
          </div>
        </div>

        <div class="intro-meta reveal">
          <span>03 PROYECTOS</span>
          <span>WEB / DIGITAL / CREATIVE</span>
          <span>MARACAIBO · VENEZUELA</span>
        </div>
      </section>

      <!-- =======================================================
           FEATURED PROJECT
      ======================================================== -->
      <section class="featured-project section-block" id="alsaca">
        <div class="section-heading reveal">
          <div>
            <span class="eyebrow">01 — FEATURED PROJECT</span>
            <h2>ALSACA</h2>
          </div>

          <span class="section-number">01</span>
        </div>

        <article class="featured-project-layout reveal">
          <div class="featured-image-wrap">
            <a
              href={projects[0].href}
              target="_blank"
              rel="noopener noreferrer"
              class="featured-image magnetic"
              aria-label="Abrir proyecto ALSACA"
            >
              <img
                src={projects[0].image}
                alt="Vista previa del proyecto ALSACA"
                loading="eager"
              />

              <div class="image-overlay"></div>

              <div class="image-corner top-left"></div>
              <div class="image-corner top-right"></div>
              <div class="image-corner bottom-left"></div>
              <div class="image-corner bottom-right"></div>

              <span class="image-open">
                ABRIR
                <span>↗</span>
              </span>
            </a>
          </div>

          <div class="featured-info">
            <div class="project-label">
              <span>01</span>
              <span>{projects[0].category}</span>
            </div>

            <h3>{projects[0].title}</h3>

            <p class="featured-description">
              {projects[0].description}
            </p>

            <div class="project-details">
              <div class="detail-row">
                <span>TIPO</span>
                <strong>PLATAFORMA WEB</strong>
              </div>

              <div class="detail-row">
                <span>ÁREA</span>
                <strong>GESTIÓN DIGITAL</strong>
              </div>

              <div class="detail-row">
                <span>ESTADO</span>
                <strong>DEMO DISPONIBLE</strong>
              </div>
            </div>

            <a
              href={projects[0].href}
              target="_blank"
              rel="noopener noreferrer"
              class="project-button magnetic"
            >
              <span>VER PROYECTO</span>
              <span class="button-arrow">↗</span>
            </a>
          </div>
        </article>
      </section>

      <!-- =======================================================
           OTHER PROJECTS
      ======================================================== -->
      <section class="other-projects section-block" id="otros-proyectos">
        <div class="section-heading reveal">
          <div>
            <span class="eyebrow">02 — OTHER PROJECTS</span>
            <h2>EXPLORACIÓN</h2>
          </div>

          <span class="section-number">02</span>
        </div>

        <div class="projects-grid">

          <!-- RED MARKET -->
          <article class="project-card project-card-small reveal reveal-delay">
            <a
              href={projects[1].href}
              class="project-card-image magnetic"
              aria-label="Proyecto RED MARKET CORE"
            >
              <img
                src={projects[1].image}
                alt="Vista previa de RED MARKET CORE"
                loading="lazy"
              />

              <div class="card-overlay"></div>

              <span class="project-card-index">02</span>

              <span class="project-card-open">
                ↗
              </span>
            </a>

            <div class="project-card-content">
              <div class="project-card-meta">
                <span>{projects[1].category}</span>
                <span>02</span>
              </div>

              <h3>{projects[1].title}</h3>

              <p>
                {projects[1].description}
              </p>

              <a href={projects[1].href} class="text-link">
                <span>EXPLORAR PROYECTO</span>
                <span>↗</span>
              </a>
            </div>
          </article>
        </div>
      </section>

      <!-- =======================================================
           PROJECT PHILOSOPHY
      ======================================================== -->
      <section class="project-statement section-block">
        <div class="statement-line reveal"></div>

        <div class="statement-grid">
          <div class="statement-label reveal">
            <span>PRØYET_RED</span>
            <span>APPROACH / 03</span>
          </div>

          <div class="statement-content reveal reveal-delay">
            <p class="statement-main">
              No se trata solamente de construir algo que
              funcione. Se trata de construir algo que tenga
              una identidad.
            </p>

            <p class="statement-secondary">
              Cada proyecto busca encontrar un equilibrio
              entre estructura, utilidad y lenguaje visual.
              La tecnología resuelve el problema; el diseño
              ayuda a darle forma.
            </p>
          </div>
        </div>
      </section>

      <!-- =======================================================
           CTA
      ======================================================== -->
      <section class="contact-section" id="contacto">
        <div class="contact-shell reveal">

          <div class="contact-side">
            <span class="eyebrow">LET'S WORK TOGETHER</span>

            <h2>
              ¿TRABAJAMOS<br />
              JUNTOS<span>?</span>
            </h2>

            <a
              href="https://wa.me/584122791704?text=Hola%20David,%20me%20gustar%C3%ADa%20hablar%20contigo%20sobre%20un%20proyecto."
              target="_blank"
              rel="noopener noreferrer"
              class="contact-email magnetic"
            >
              <span>Contactarme por WhatsApp</span>
              <span>↗</span>
            </a>
          </div>

          <div class="contact-brand">
            <div class="contact-logo">
              <img src="/assets/images/Logo.png" alt="NERAEL" />
            </div>

            <div class="contact-brand-name">
              NERAEL<span>.</span>
            </div>

            <div class="contact-brand-meta">
              <span>SOFTWARE · DESIGN · EDITION</span>
              <span>MARACAIBO · VENEZUELA</span>
            </div>
          </div>

        </div>
      </section>

      <!-- =======================================================
           FOOTER
      ======================================================== -->
      <footer class="site-footer">
        <div class="footer-main">

          <div class="footer-brand">
            <a href="/" class="footer-logo">
              <span class="footer-logo-mark">
                <img src="/assets/images/Logo.png" alt="" />
              </span>

              <span>PRØYET_RED</span>
            </a>

            <p>
              Desarrollo de software y sistemas digitales
              construidos con una perspectiva funcional
              y visual.
            </p>

            <a href="mailto:nerael.m@gmail.com" class="footer-email">
              nerael.m@gmail.com
            </a>
          </div>

          <div class="footer-column">
            <span class="footer-heading">NAVEGACIÓN</span>

            <a href="/">Inicio</a>
            <a href="/proyectos">Proyectos</a>
            <a href="/diseno">Diseño</a>
            <a href="/edicion">Edición</a>
            <a href="/sobre-mi">Sobre mí</a>
          </div>

          <div class="footer-column">
            <span class="footer-heading">ÁREAS</span>

            <span>Software</span>
            <span>Desarrollo web</span>
            <span>Diseño gráfico</span>
            <span>Edición</span>
            <span>Dirección visual</span>
          </div>

          <div class="footer-column">
            <span class="footer-heading">REDES</span>

            <a
              href="https://github.com/neraelm-m"
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub ↗
            </a>


            <a
              href="https://wa.me/584122791704"
              target="_blank"
              rel="noopener noreferrer"
            >
              WhatsApp ↗
            </a>
          </div>
        </div>

        <div class="footer-bottom">
          <span>PRØYET_RED © 2026</span>
          <span>DAVID MARTINEZ</span>
          <span>MARACAIBO · VENEZUELA</span>
        </div>
      </footer>
    </div>

    <!-- =========================================================
         WHATSAPP
    ========================================================== -->
    <a
      href="https://wa.me/584122791704"
      target="_blank"
      rel="noopener noreferrer"
      class="whatsapp-button magnetic"
      aria-label="Contactar por WhatsApp"
    >
      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M20.52 3.48A11.83 11.83 0 0 0 12.08 0C5.52 0 .18 5.34.18 11.91c0 2.1.55 4.15 1.6 5.96L.08 24l6.27-1.64a11.9 11.9 0 0 0 5.73 1.46h.01c6.56 0 11.9-5.34 11.9-11.91 0-3.18-1.24-6.16-3.47-8.43ZM12.09 21.8h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.72.98.99-3.62-.23-.37a9.88 9.88 0 0 1-1.51-5.29c0-5.48 4.46-9.94 9.95-9.94 2.65 0 5.14 1.03 7.01 2.91a9.9 9.9 0 0 1 2.9 7.03c-.01 5.48-4.47 9.94-9.99 9.94Zm5.45-7.44c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.49 0 1.47 1.07 2.89 1.22 3.09.15.2 2.1 3.21 5.09 4.5.71.31 1.26.5 1.69.64.71.23 1.35.2 1.86.12.57-.09 1.76-.72 2.01-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"
          fill="currentColor"
        />
      </svg>
    </a>
  </main>
</Layout>

<style>
  /* ============================================================
     BASE
  ============================================================ */

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #050506;
    color: #f4f4f4;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    overflow-x: hidden;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .projects-page {
    position: relative;
    min-height: 100vh;
    background: #050506;
    overflow: hidden;
  }

  .page-content {
    position: relative;
    z-index: 2;
  }

  /* ============================================================
     AMBIENT BACKGROUND
  ============================================================ */

  .ambient {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 78% 12%,
        rgba(120, 0, 20, 0.12),
        transparent 34%
      ),
      #050506;
  }

  .ambient-image {
    position: absolute;
    inset: -8%;
    background-size: cover;
    background-position: center;
    opacity: 0.1;
    filter: grayscale(1) contrast(1.12);
    mix-blend-mode: screen;
  }

  .ambient-image-one {
    background-image: url("/assets/images/wallpaper4.png");
    opacity: 0.08;
  }

  .ambient-image-two {
    background-image: url("/assets/images/wallpaper6.jpg");
    opacity: 0.045;
    transform: scale(1.08);
  }

  .ambient-image-three {
    background-image: url("/assets/images/wallpaper8.jpg");
    opacity: 0.035;
    transform: scale(1.12);
  }

  .red-orb {
    position: absolute;
    width: 36rem;
    height: 36rem;
    border-radius: 50%;
    background: rgba(185, 0, 32, 0.14);
    filter: blur(100px);
  }

  .orb-one {
    top: 8%;
    right: -20rem;
  }

  .orb-two {
    top: 58%;
    left: -24rem;
    opacity: 0.45;
  }

  .ambient-grid {
    position: absolute;
    inset: 0;
    opacity: 0.045;
    background-image:
      linear-gradient(
        rgba(255, 255, 255, 0.12) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.12) 1px,
        transparent 1px
      );
    background-size: 80px 80px;
    mask-image: linear-gradient(
      to bottom,
      black,
      transparent 88%
    );
  }

  .ambient-noise {
    position: absolute;
    inset: 0;
    opacity: 0.035;
    background-image: url("/assets/images/wallpaper1.png");
    background-size: 600px;
    mix-blend-mode: soft-light;
  }

  .ambient-vignette {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse at center,
        transparent 35%,
        rgba(0, 0, 0, 0.72) 100%
      );
  }

  /* ============================================================
     CURSOR / SCROLL
  ============================================================ */

  .cursor-light {
    position: fixed;
    z-index: 10;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    pointer-events: none;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      circle,
      rgba(255, 0, 45, 0.07),
      transparent 68%
    );
    filter: blur(20px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    width: 0%;
    height: 2px;
    background: linear-gradient(
      90deg,
      #65000f,
      #ff1744
    );
    box-shadow: 0 0 14px rgba(255, 23, 68, 0.6);
  }

  /* ============================================================
     HEADER
  ============================================================ */

  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 50;
    width: 100%;
    padding: 18px 24px;
    transition:
      padding 0.35s ease,
      transform 0.35s ease;
  }

  .nav-shell {
    width: min(1240px, 100%);
    min-height: 66px;
    margin: 0 auto;
    padding: 0 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 22px;
    background: rgba(10, 10, 12, 0.54);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
    box-shadow:
      0 20px 70px rgba(0, 0, 0, 0.22),
      inset 0 1px rgba(255, 255, 255, 0.035);
    transition:
      background 0.3s ease,
      border-color 0.3s ease;
  }

  .site-header.scrolled .nav-shell {
    background: rgba(7, 7, 9, 0.76);
    border-color: rgba(255, 255, 255, 0.12);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-width: max-content;
  }

  .brand-mark {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .brand-mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .brand-name {
    font-size: 0.77rem;
    font-weight: 700;
    letter-spacing: 0.17em;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav-link,
  .nav-contact {
    position: relative;
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    color: rgba(255, 255, 255, 0.58);
    transition: color 0.25s ease;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -7px;
    width: 0;
    height: 1px;
    background: #ff1744;
    box-shadow: 0 0 10px rgba(255, 23, 68, 0.6);
    transition: width 0.25s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: #fff;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  .nav-contact {
    padding: 10px 14px;
    color: #fff;
    border: 1px solid rgba(255, 23, 68, 0.45);
    border-radius: 999px;
    background: rgba(150, 0, 25, 0.12);
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s ease;
  }

  .nav-contact:hover {
    background: rgba(255, 23, 68, 0.15);
    border-color: rgba(255, 23, 68, 0.75);
  }

  .menu-toggle {
    display: none;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.035);
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    width: 16px;
    height: 1px;
    margin: 5px auto;
    background: #fff;
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }

  .menu-toggle.open span:first-child {
    transform: translateY(3px) rotate(45deg);
  }

  .menu-toggle.open span:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  /* ============================================================
     MOBILE MENU
  ============================================================ */

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 45;
    display: flex;
    align-items: stretch;
    background: rgba(4, 4, 5, 0.96);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-10px);
    transition:
      opacity 0.35s ease,
      transform 0.35s ease,
      visibility 0.35s ease;
  }

  .mobile-menu.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .mobile-menu-inner {
    width: 100%;
    padding: 110px 24px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .mobile-menu-top,
  .mobile-menu-bottom {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: rgba(255, 255, 255, 0.42);
    font-size: 0.58rem;
    letter-spacing: 0.13em;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
  }

  .mobile-link {
    display: grid;
    grid-template-columns: 42px 1fr;
    align-items: center;
    padding: 18px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mobile-link span {
    color: rgba(255, 23, 68, 0.72);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
  }

  .mobile-link strong {
    font-size: clamp(1.8rem, 8vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .mobile-link.current strong {
    color: #ff1744;
  }

  /* ============================================================
     INTRO
  ============================================================ */

  .projects-intro {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    padding:
      clamp(125px, 14vw, 165px)
      0
      clamp(60px, 7vw, 85px);
  }

  .section-kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 36px;
    color: rgba(255, 255, 255, 0.42);
    font-size: 0.63rem;
    font-weight: 600;
    letter-spacing: 0.17em;
  }

  .kicker-line {
    width: 34px;
    height: 1px;
    background: #ff1744;
    box-shadow: 0 0 12px rgba(255, 23, 68, 0.55);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
    gap: 80px;
    align-items: end;
  }

  .intro-index {
    margin: 0 0 15px;
    color: rgba(255, 255, 255, 0.32);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
  }

  .intro-title-wrap h1 {
    margin: 0;
    font-size: clamp(4rem, 9vw, 8.5rem);
    line-height: 0.84;
    font-weight: 600;
    letter-spacing: -0.075em;
  }

  .intro-title-wrap h1 span {
    color: #ff1744;
    text-shadow: 0 0 35px rgba(255, 23, 68, 0.25);
  }

  .intro-copy {
    padding-bottom: 5px;
  }

  .intro-lead {
    max-width: 460px;
    margin: 0 0 22px;
    font-size: clamp(1.05rem, 1.8vw, 1.45rem);
    line-height: 1.35;
    letter-spacing: -0.025em;
    color: rgba(255, 255, 255, 0.87);
  }

  .intro-small {
    max-width: 420px;
    margin: 0;
    color: rgba(255, 255, 255, 0.43);
    font-size: 0.82rem;
    line-height: 1.75;
  }

  .intro-meta {
    display: flex;
    justify-content: space-between;
    gap: 30px;
    margin-top: 64px;
    padding-top: 17px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.33);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
  }

  /* ============================================================
     COMMON SECTION
  ============================================================ */

  .section-block {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    padding: 70px 0;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 30px;
    margin-bottom: 38px;
  }

  .eyebrow {
    display: block;
    margin-bottom: 12px;
    color: rgba(255, 255, 255, 0.38);
    font-size: 0.59rem;
    font-weight: 600;
    letter-spacing: 0.16em;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 4.4rem);
    line-height: 0.95;
    font-weight: 500;
    letter-spacing: -0.055em;
  }

  .section-number {
    color: rgba(255, 23, 68, 0.72);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
  }

  /* ============================================================
     FEATURED PROJECT
  ============================================================ */

  .featured-project-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(300px, 0.5fr);
    gap: 28px;
    align-items: stretch;
  }

  .featured-image-wrap {
    min-width: 0;
  }

  .featured-image {
    position: relative;
    display: block;
    height: 100%;
    min-height: 560px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 30px;
    background: rgba(255, 255, 255, 0.025);
    box-shadow:
      0 30px 90px rgba(0, 0, 0, 0.35),
      inset 0 1px rgba(255, 255, 255, 0.06);
  }

  .featured-image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 0.5s ease;
  }

  .featured-image:hover img {
    transform: scale(1.035);
    filter: saturate(1.08);
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.04),
        rgba(0, 0, 0, 0.15) 50%,
        rgba(0, 0, 0, 0.7)
      );
    transition: opacity 0.4s ease;
  }

  .featured-image:hover .image-overlay {
    opacity: 0.78;
  }

  .image-corner {
    position: absolute;
    width: 16px;
    height: 16px;
    border-color: rgba(255, 255, 255, 0.55);
    opacity: 0.75;
  }

  .image-corner.top-left {
    top: 18px;
    left: 18px;
    border-top: 1px solid;
    border-left: 1px solid;
  }

  .image-corner.top-right {
    top: 18px;
    right: 18px;
    border-top: 1px solid;
    border-right: 1px solid;
  }

  .image-corner.bottom-left {
    bottom: 18px;
    left: 18px;
    border-bottom: 1px solid;
    border-left: 1px solid;
  }

  .image-corner.bottom-right {
    right: 18px;
    bottom: 18px;
    border-right: 1px solid;
    border-bottom: 1px solid;
  }

  .image-open {
    position: absolute;
    right: 24px;
    bottom: 23px;
    display: flex;
    align-items: center;
    gap: 12px;
    color: #fff;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .image-open span {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(8px);
    transition:
      background 0.25s ease,
      border-color 0.25s ease;
  }

  .featured-image:hover .image-open span {
    background: rgba(255, 23, 68, 0.2);
    border-color: rgba(255, 23, 68, 0.65);
  }

  .featured-info {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 560px;
    padding: 34px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 30px;
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.065),
        rgba(255, 255, 255, 0.018)
      );
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow:
      0 30px 90px rgba(0, 0, 0, 0.26),
      inset 0 1px rgba(255, 255, 255, 0.035);
  }

  .project-label {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: auto;
    color: rgba(255, 255, 255, 0.38);
    font-size: 0.58rem;
    letter-spacing: 0.13em;
  }

  .project-label span:first-child {
    color: #ff1744;
  }

  .featured-info h3 {
    margin: 80px 0 15px;
    font-size: clamp(2.5rem, 5vw, 4.8rem);
    line-height: 0.9;
    font-weight: 500;
    letter-spacing: -0.065em;
  }

  .featured-description {
    margin: 0;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.84rem;
    line-height: 1.7;
  }

  .project-details {
    margin-top: 35px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding: 13px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
  }

  .detail-row span {
    color: rgba(255, 255, 255, 0.32);
  }

  .detail-row strong {
    color: rgba(255, 255, 255, 0.68);
    font-weight: 500;
    text-align: right;
  }

  .project-button {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 28px;
    padding: 14px 16px 14px 18px;
    border: 1px solid rgba(255, 23, 68, 0.46);
    border-radius: 14px;
    background: rgba(255, 23, 68, 0.08);
    color: #fff;
    font-size: 0.61rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      transform 0.3s ease;
  }

  .project-button:hover {
    background: rgba(255, 23, 68, 0.16);
    border-color: rgba(255, 23, 68, 0.8);
  }

  .button-arrow {
    font-size: 1rem;
    color: #ff1744;
  }

  /* ============================================================
     OTHER PROJECTS
  ============================================================ */

  .other-projects {
    padding-top: 78px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: minmax(0, 820px);
    gap: 28px;
    align-items: start;
  }

  .project-card {
    min-width: 0;
  }

  .project-card-small {
    margin-top: 0;
  }

  .project-card-image {
    position: relative;
    display: block;
    height: 390px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 26px;
    background: rgba(255, 255, 255, 0.025);
  }

  .project-card-small .project-card-image {
    height: 390px;
  }

  .project-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 0.45s ease;
  }

  .project-card-image:hover img {
    transform: scale(1.045);
    filter: saturate(1.08);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        transparent 45%,
        rgba(0, 0, 0, 0.7)
      );
  }

  .project-card-index {
    position: absolute;
    top: 20px;
    left: 21px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.62rem;
    letter-spacing: 0.13em;
  }

  .project-card-open {
    position: absolute;
    right: 19px;
    bottom: 18px;
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(10px);
    font-size: 1rem;
    transition:
      background 0.3s ease,
      border-color 0.3s ease;
  }

  .project-card-image:hover .project-card-open {
    background: rgba(255, 23, 68, 0.16);
    border-color: rgba(255, 23, 68, 0.62);
  }

  .project-card-content {
    padding: 22px 5px 0;
  }

  .project-card-meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 14px;
    color: rgba(255, 255, 255, 0.32);
    font-size: 0.58rem;
    letter-spacing: 0.13em;
  }

  .project-card-meta span:last-child {
    color: rgba(255, 23, 68, 0.68);
  }

  .project-card-content h3 {
    margin: 0 0 12px;
    font-size: clamp(1.55rem, 3vw, 2.55rem);
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.045em;
  }

  .project-card-content p {
    max-width: 580px;
    margin: 0;
    color: rgba(255, 255, 255, 0.44);
    font-size: 0.78rem;
    line-height: 1.7;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-top: 20px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    transition: color 0.25s ease;
  }

  .text-link span:last-child {
    color: #ff1744;
    font-size: 0.9rem;
    transition: transform 0.25s ease;
  }

  .text-link:hover {
    color: #fff;
  }

  .text-link:hover span:last-child {
    transform: translate(3px, -3px);
  }

  /* ============================================================
     STATEMENT
  ============================================================ */

  .project-statement {
    padding-top: 105px;
    padding-bottom: 105px;
  }

  .statement-line {
    width: 100%;
    height: 1px;
    margin-bottom: 40px;
    background: rgba(255, 255, 255, 0.1);
  }

  .statement-grid {
    display: grid;
    grid-template-columns: 0.35fr 1.65fr;
    gap: 60px;
  }

  .statement-label {
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: rgba(255, 255, 255, 0.28);
    font-size: 0.58rem;
    letter-spacing: 0.13em;
  }

  .statement-content {
    max-width: 850px;
  }

  .statement-main {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.7rem);
    line-height: 1.08;
    font-weight: 400;
    letter-spacing: -0.045em;
  }

  .statement-secondary {
    max-width: 620px;
    margin: 30px 0 0;
    color: rgba(255, 255, 255, 0.42);
    font-size: 0.84rem;
    line-height: 1.8;
  }

  /* ============================================================
     CONTACT
  ============================================================ */

  .contact-section {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    padding: 25px 0 78px;
  }

  .contact-shell {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    min-height: 285px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 30px;
    background:
      linear-gradient(
        125deg,
        rgba(255, 255, 255, 0.055),
        rgba(255, 255, 255, 0.018)
      );
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
    box-shadow:
      0 30px 100px rgba(0, 0, 0, 0.3),
      inset 0 1px rgba(255, 255, 255, 0.045);
  }

  .contact-side {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 38px 44px;
  }

  .contact-side h2 {
    margin: 0;
    font-size: clamp(2.8rem, 5.8vw, 5.7rem);
    line-height: 0.9;
    font-weight: 500;
    letter-spacing: -0.065em;
  }

  .contact-side h2 span {
    color: #ff1744;
  }

  .contact-email {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: min(390px, 100%);
    margin-top: 34px;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.17);
    color: rgba(255, 255, 255, 0.64);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    transition:
      color 0.25s ease,
      border-color 0.25s ease;
  }

  .contact-email span:last-child {
    color: #ff1744;
    font-size: 1rem;
  }

  .contact-email:hover {
    color: #fff;
    border-color: rgba(255, 23, 68, 0.55);
  }

  .contact-brand {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 38px 44px;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    background:
      radial-gradient(
        circle at 50% 42%,
        rgba(255, 23, 68, 0.11),
        transparent 55%
      );
  }

  .contact-logo {
    width: 48px;
    height: 48px;
    margin-bottom: 17px;
    padding: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.035);
  }

  .contact-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .contact-brand-name {
    font-size: clamp(2.6rem, 5vw, 5rem);
    line-height: 0.85;
    font-weight: 600;
    letter-spacing: -0.075em;
  }

  .contact-brand-name span {
    color: #ff1744;
  }

  .contact-brand-meta {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-top: 28px;
    color: rgba(255, 255, 255, 0.33);
    font-size: 0.57rem;
    letter-spacing: 0.13em;
  }

  /* ============================================================
     FOOTER
  ============================================================ */

  .site-footer {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    padding: 50px 0 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.09);
  }

  .footer-main {
    display: grid;
    grid-template-columns: 1.6fr 0.7fr 0.7fr 0.7fr;
    gap: 50px;
    padding-bottom: 50px;
  }

  .footer-brand {
    max-width: 380px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  .footer-logo-mark {
    width: 27px;
    height: 27px;
    display: grid;
    place-items: center;
    padding: 5px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.035);
  }

  .footer-logo-mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .footer-brand p {
    margin: 22px 0 20px;
    color: rgba(255, 255, 255, 0.36);
    font-size: 0.76rem;
    line-height: 1.75;
  }

  .footer-email {
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.67rem;
    transition: color 0.25s ease;
  }

  .footer-email:hover {
    color: #ff1744;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 11px;
  }

  .footer-heading {
    margin-bottom: 8px;
    color: rgba(255, 255, 255, 0.27);
    font-size: 0.57rem;
    font-weight: 600;
    letter-spacing: 0.15em;
  }

  .footer-column a,
  .footer-column > span:not(.footer-heading) {
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.66rem;
    transition: color 0.25s ease;
  }

  .footer-column a:hover {
    color: #fff;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 25px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    color: rgba(255, 255, 255, 0.25);
    font-size: 0.55rem;
    letter-spacing: 0.13em;
  }

  /* ============================================================
     WHATSAPP
  ============================================================ */

  .whatsapp-button {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 40;
    display: grid;
    width: 45px;
    height: 45px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 50%;
    background: rgba(7, 7, 9, 0.7);
    color: #fff;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow:
      0 12px 40px rgba(0, 0, 0, 0.35),
      inset 0 1px rgba(255, 255, 255, 0.06);
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease;
  }

  .whatsapp-button:hover {
    color: #25d366;
    border-color: rgba(37, 211, 102, 0.5);
    transform: translateY(-3px);
  }

  .whatsapp-button svg {
    width: 20px;
    height: 20px;
  }

  /* ============================================================
     REVEAL ANIMATIONS
  ============================================================ */

  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .reveal-delay {
    transition-delay: 0.1s;
  }

  /* ============================================================
     RESPONSIVE
  ============================================================ */

  @media (max-width: 1050px) {
    .desktop-nav {
      gap: 16px;
    }

    .nav-link,
    .nav-contact {
      font-size: 0.57rem;
    }

    .intro-grid {
      gap: 50px;
    }

    .featured-project-layout {
      grid-template-columns: 1fr 0.65fr;
    }

    .featured-image {
      min-height: 500px;
    }

    .featured-info {
      min-height: 500px;
      padding: 28px;
    }

    .footer-main {
      grid-template-columns: 1.4fr 0.8fr 0.8fr 0.8fr;
      gap: 35px;
    }
  }

  @media (max-width: 820px) {
    .site-header {
      padding: 14px 16px;
    }

    .nav-shell {
      min-height: 60px;
      border-radius: 18px;
    }

    .desktop-nav {
      display: none;
    }

    .menu-toggle {
      display: block;
    }

    .projects-intro,
    .section-block,
    .contact-section,
    .site-footer {
      width: min(100% - 36px, 680px);
    }

    .projects-intro {
      padding-top: 132px;
    }

    .intro-grid {
      grid-template-columns: 1fr;
      gap: 38px;
    }

    .intro-title-wrap h1 {
      font-size: clamp(3.8rem, 15vw, 7rem);
    }

    .intro-copy {
      max-width: 560px;
    }

    .intro-meta {
      flex-wrap: wrap;
      gap: 13px 28px;
      margin-top: 48px;
    }

    .featured-project-layout {
      grid-template-columns: 1fr;
    }

    .featured-image {
      min-height: 430px;
    }

    .featured-info {
      min-height: auto;
    }

    .featured-info h3 {
      margin-top: 65px;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .project-card-small {
      margin-top: 20px;
    }

    .project-card-image,
    .project-card-small .project-card-image {
      height: 390px;
    }

    .statement-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .statement-content {
      max-width: 650px;
    }

    .contact-shell {
      grid-template-columns: 1fr;
    }

    .contact-side {
      padding: 40px 34px;
    }

    .contact-brand {
      min-height: 250px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      border-left: 0;
      padding: 40px 34px;
    }

    .footer-main {
      grid-template-columns: 1.5fr 1fr 1fr;
    }

    .footer-column:last-child {
      grid-column: 2 / -1;
    }
  }

  @media (max-width: 560px) {
    .brand-name {
      font-size: 0.68rem;
    }

    .brand-mark {
      width: 27px;
      height: 27px;
    }

    .mobile-menu-inner {
      padding-left: 20px;
      padding-right: 20px;
    }

    .projects-intro,
    .section-block,
    .contact-section,
    .site-footer {
      width: calc(100% - 28px);
    }

    .projects-intro {
      padding-top: 120px;
      padding-bottom: 60px;
    }

    .section-block {
      padding: 65px 0;
    }

    .intro-title-wrap h1 {
      font-size: clamp(3.3rem, 16vw, 5.3rem);
    }

    .intro-lead {
      font-size: 1rem;
    }

    .intro-small {
      font-size: 0.75rem;
    }

    .intro-meta {
      font-size: 0.51rem;
    }

    .section-heading {
      margin-bottom: 26px;
    }

    .section-heading h2 {
      font-size: 2.2rem;
    }

    .featured-image {
      min-height: 330px;
      border-radius: 22px;
    }

    .featured-info {
      padding: 24px;
      border-radius: 22px;
    }

    .featured-info h3 {
      margin-top: 50px;
      font-size: 2.8rem;
    }

    .featured-description {
      font-size: 0.76rem;
    }

    .detail-row {
      flex-direction: column;
      gap: 6px;
    }

    .detail-row strong {
      text-align: left;
    }

    .project-card-image,
    .project-card-small .project-card-image {
      height: 275px;
      border-radius: 21px;
    }

    .project-card-content h3 {
      font-size: 1.7rem;
    }

    .project-card-content p {
      font-size: 0.74rem;
    }

    .project-statement {
      padding-top: 85px;
      padding-bottom: 90px;
    }

    .statement-main {
      font-size: 1.9rem;
    }

    .statement-secondary {
      font-size: 0.76rem;
    }

    .contact-section {
      padding-bottom: 75px;
    }

    .contact-shell {
      border-radius: 23px;
    }

    .contact-side {
      padding: 32px 25px;
    }

    .contact-side h2 {
      font-size: 3.1rem;
    }

    .contact-brand {
      min-height: 220px;
      padding: 32px 25px;
    }

    .contact-brand-name {
      font-size: 3.1rem;
    }

    .site-footer {
      padding-top: 45px;
    }

    .footer-main {
      grid-template-columns: 1fr 1fr;
      gap: 40px 25px;
      padding-bottom: 45px;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-column:last-child {
      grid-column: auto;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 9px;
    }

    .whatsapp-button {
      right: 16px;
      bottom: 16px;
      width: 43px;
      height: 43px;
    }

    .cursor-light {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }

    .reveal {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("#site-header");
  const progress =
    document.querySelector<HTMLElement>(".scroll-progress");

  const cursor =
    document.querySelector<HTMLElement>(".cursor-light");

  const menuToggle =
    document.querySelector<HTMLButtonElement>(".menu-toggle");

  const mobileMenu =
    document.querySelector<HTMLElement>("#mobile-menu");

  const mobileLinks =
    document.querySelectorAll<HTMLAnchorElement>(".mobile-link");

  const magneticElements =
    document.querySelectorAll<HTMLElement>(".magnetic");

  const revealElements =
    document.querySelectorAll<HTMLElement>(".reveal");

  /* ==========================================================
     HEADER + SCROLL PROGRESS
  ========================================================== */

  const updateScroll = () => {
    const scrollTop = window.scrollY;

    const documentHeight =
      document.documentElement.scrollHeight -
      window.innerHeight;

    const percentage =
      documentHeight > 0
        ? (scrollTop / documentHeight) * 100
        : 0;

    if (progress) {
      progress.style.width = `${percentage}%`;
    }

    if (header) {
      header.classList.toggle(
        "scrolled",
        scrollTop > 40
      );
    }
  };

  window.addEventListener("scroll", updateScroll, {
    passive: true,
  });

  updateScroll();

  /* ==========================================================
     CURSOR LIGHT
  ========================================================== */

  if (
    cursor &&
    window.matchMedia("(pointer: fine)").matches
  ) {
    window.addEventListener(
      "mousemove",
      (event: MouseEvent) => {
        cursor.style.left = `${event.clientX}px`;
        cursor.style.top = `${event.clientY}px`;
        cursor.style.opacity = "1";
      }
    );

    document.addEventListener("mouseleave", () => {
      cursor.style.opacity = "0";
    });
  }

  /* ==========================================================
     MOBILE MENU
  ========================================================== */

  const closeMenu = () => {
    if (!menuToggle || !mobileMenu) return;

    menuToggle.classList.remove("open");

    menuToggle.setAttribute(
      "aria-expanded",
      "false"
    );

    mobileMenu.classList.remove("open");

    mobileMenu.setAttribute(
      "aria-hidden",
      "true"
    );

    document.body.style.overflow = "";
  };

  const openMenu = () => {
    if (!menuToggle || !mobileMenu) return;

    menuToggle.classList.add("open");

    menuToggle.setAttribute(
      "aria-expanded",
      "true"
    );

    mobileMenu.classList.add("open");

    mobileMenu.setAttribute(
      "aria-hidden",
      "false"
    );

    document.body.style.overflow = "hidden";
  };

  menuToggle?.addEventListener("click", () => {
    const isOpen =
      menuToggle.getAttribute(
        "aria-expanded"
      ) === "true";

    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  mobileLinks.forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  document.addEventListener(
    "keydown",
    (event: KeyboardEvent) => {
      if (event.key === "Escape") {
        closeMenu();
      }
    }
  );

  /* ==========================================================
     REVEAL ON SCROLL
  ========================================================== */

  if ("IntersectionObserver" in window) {
    const observer =
      new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const element =
                entry.target as HTMLElement;

              element.classList.add("visible");

              observer.unobserve(element);
            }
          });
        },
        {
          threshold: 0.12,
          rootMargin: "0px 0px -40px 0px",
        }
      );

    revealElements.forEach((element) => {
      observer.observe(element);
    });
  } else {
    revealElements.forEach((element) => {
      element.classList.add("visible");
    });
  }

  /* ==========================================================
     MAGNETIC ELEMENTS
  ========================================================== */

  if (
    window.matchMedia("(pointer: fine)").matches
  ) {
    magneticElements.forEach((element) => {
      element.addEventListener(
        "mousemove",
        (event: MouseEvent) => {
          const rect =
            element.getBoundingClientRect();

          const x =
            event.clientX -
            rect.left -
            rect.width / 2;

          const y =
            event.clientY -
            rect.top -
            rect.height / 2;

          element.style.transform =
            `translate(${x * 0.08}px, ${y * 0.08}px)`;
        }
      );

      element.addEventListener(
        "mouseleave",
        () => {
          element.style.transform = "";
        }
      );
    });
  }

  /* ==========================================================
     FEATURED PROJECT IMAGE PARALLAX
  ========================================================== */

  const featuredImage =
    document.querySelector<HTMLElement>(
      ".featured-image"
    );

  if (
    featuredImage &&
    window.matchMedia("(pointer: fine)").matches
  ) {
    featuredImage.addEventListener(
      "mousemove",
      (event: MouseEvent) => {
        const rect =
          featuredImage.getBoundingClientRect();

        const x =
          (event.clientX - rect.left) /
            rect.width -
          0.5;

        const y =
          (event.clientY - rect.top) /
            rect.height -
          0.5;

        const image =
          featuredImage.querySelector<HTMLElement>(
            "img"
          );

        if (image) {
          image.style.transform =
            `scale(1.035) translate(${x * 8}px, ${y * 8}px)`;
        }
      }
    );

    featuredImage.addEventListener(
      "mouseleave",
      () => {
        const image =
          featuredImage.querySelector<HTMLElement>(
            "img"
          );

        if (image) {
          image.style.transform = "";
        }
      }
    );
  }

  /* ==========================================================
     PROJECT CARD TILT
  ========================================================== */

  const projectCards =
    document.querySelectorAll<HTMLElement>(
      ".project-card-image"
    );

  if (
    window.matchMedia("(pointer: fine)").matches
  ) {
    projectCards.forEach((card) => {
      card.addEventListener(
        "mousemove",
        (event: MouseEvent) => {
          const rect =
            card.getBoundingClientRect();

          const x =
            (event.clientX - rect.left) /
              rect.width -
            0.5;

          const y =
            (event.clientY - rect.top) /
              rect.height -
            0.5;

          card.style.transform =
            `perspective(900px) rotateX(${y * -2}deg) rotateY(${x * 2}deg)`;
        }
      );

      card.addEventListener(
        "mouseleave",
        () => {
          card.style.transform = "";
        }
      );
    });
  }
</script>