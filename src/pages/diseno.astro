---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";

const designProjects = [
  {
    title: "PRØYET_RED",
    category: "IDENTIDAD · BRANDING",
    description: "Identidad visual y dirección gráfica desarrollada bajo PRØYET_RED.",
    image: "/assets/diseno/Proyet_Red.png",
    featured: true,
  },
  {
    title: "BANNER 02",
    category: "DISEÑO GRÁFICO · BANNER",
    description: "Pieza gráfica de composición y comunicación visual.",
    image: "/assets/diseno/Banner%202.png",
    featured: false,
  },
  {
    title: "CONSTRUCCIÓN",
    category: "CONCEPTO · IDENTIDAD VISUAL",
    description: "Recurso visual creado para representar construcción y desarrollo creativo.",
    image: "/assets/diseno/construccion.png",
    featured: false,
  },
  {
    title: "LOGO",
    category: "LOGOTIPO · IDENTIDAD",
    description: "Exploración de símbolo, forma y lenguaje tipográfico.",
    image: "/assets/diseno/Logo.jpeg",
    featured: false,
  },
  {
    title: "OFFLINE KICK",
    category: "IDENTIDAD · PROMOCIONAL",
    description: "Pieza visual con tratamiento gráfico y composición digital.",
    image: "/assets/diseno/Offline_Kick.jpg",
    featured: false,
  },
  {
    title: "PRØYET_RED · MARK",
    category: "IDENTIDAD · LOGO",
    description: "Versión de marca y exploración del sistema gráfico PRØYET_RED.",
    image: "/assets/diseno/Logo.png",
    featured: false,
  },
];

const services = [
  "Identidad visual",
  "Branding",
  "Diseño gráfico",
  "Piezas para redes",
  "Composición visual",
  "Dirección de arte",
  "Presentaciones",
  "Contenido digital",
];
---

<Layout
  title="Diseño Gráfico · NERAEL"
  description="Diseño gráfico, identidad visual y dirección de arte de David Martinez bajo PRØYET_RED."
>
  <div class="site-shell">
    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>
    <div class="ambient ambient-three"></div>
    <div class="grid-bg"></div>
    <div class="noise"></div>
    <div class="vignette"></div>

    <div class="cursor-light" aria-hidden="true"></div>
    <div class="scroll-progress" aria-hidden="true"></div>

    <SiteHeader active="diseno" />

    <main>
      <section class="design-hero reveal">
        <div class="hero-copy">
          <div class="eyebrow">
            <span>SELECTED DESIGN</span>
            <span>03 / 05</span>
          </div>

          <h1>
            DISEÑO
            <em>GRÁFICO.</em>
          </h1>

          <p class="hero-description">
            Diseño identidades y piezas visuales combinando composición,
            dirección de arte y una estética digital propia.
          </p>

          <div class="hero-actions">
            <a href="#trabajos" class="button button-primary">
              <span>VER TRABAJOS</span>
              <span>↘</span>
            </a>
            <a href="#contacto" class="button button-ghost">
              <span>HABLEMOS</span>
              <span>↗</span>
            </a>
          </div>
        </div>

        <div class="hero-visual">
          <div class="hero-frame">
            <div class="frame-label frame-label-top">
              <span>PRØYET_RED</span>
              <span>VISUAL SYSTEM</span>
            </div>

            <img
              src="/assets/diseno/Proyet_Red.png"
              alt="Identidad visual PRØYET_RED"
              loading="eager"
            />

            <div class="frame-label frame-label-bottom">
              <span>BRANDING / GRAPHIC DESIGN</span>
              <span>2026</span>
            </div>
          </div>

          <div class="hero-orbit" aria-hidden="true">
            <span></span>
            <span></span>
          </div>
        </div>
      </section>

      <section class="statement reveal">
        <div class="section-index">01 / ENFOQUE</div>
        <div class="statement-copy">
          <p>
            El diseño no es un elemento separado del proyecto.
            Es la forma en que una idea adquiere identidad, estructura y presencia.
          </p>
        </div>
      </section>

      <section class="work-section" id="trabajos">
        <div class="section-heading reveal">
          <div>
            <span class="section-kicker">SELECTED WORK / 2026</span>
            <h2>TRABAJOS<span>.</span></h2>
          </div>
          <p>
            Una selección de piezas, identidades y recursos visuales desarrollados
            bajo PRØYET_RED.
          </p>
        </div>

        <div class="design-grid">
          {designProjects.map((project, index) => (
            <article class:list={["design-card", project.featured && "featured", "reveal"]}>
              <div class="card-media">
                <div class="media-topline">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <span>{project.category}</span>
                </div>

                <img src={project.image} alt={project.title} loading={index === 0 ? "eager" : "lazy"} />

                <div class="media-corner">↗</div>
              </div>

              <div class="card-info">
                <div>
                  <span class="card-number">0{index + 1}</span>
                  <h3>{project.title}</h3>
                </div>
                <p>{project.description}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="services-section reveal">
        <div class="section-index">02 / SERVICIOS</div>

        <div class="services-content">
          <div class="services-intro">
            <span class="section-kicker">VISUAL DIRECTION</span>
            <h2>UNA IDENTIDAD<br /><em>RECONOCIBLE.</em></h2>
            <p>
              Desde una pieza puntual hasta un sistema visual completo,
              cada elemento busca mantener coherencia entre concepto, forma y aplicación.
            </p>
          </div>

          <div class="services-list">
            {services.map((service, index) => (
              <div class="service-row">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{service}</strong>
                <span class="service-arrow">↗</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="process-section reveal">
        <div class="section-heading compact">
          <div>
            <span class="section-kicker">PROCESS / PRØYET_RED</span>
            <h2>DEL CONCEPTO<br /><span>A LA PIEZA.</span></h2>
          </div>
        </div>

        <div class="process-grid">
          <article>
            <span>01</span>
            <h3>CONCEPTO</h3>
            <p>Definir la idea, el lenguaje y la intención de la pieza.</p>
          </article>
          <article>
            <span>02</span>
            <h3>COMPOSICIÓN</h3>
            <p>Construir jerarquía, ritmo, tipografía y relaciones visuales.</p>
          </article>
          <article>
            <span>03</span>
            <h3>DESARROLLO</h3>
            <p>Convertir el concepto en una pieza lista para su aplicación.</p>
          </article>
          <article>
            <span>04</span>
            <h3>DETALLE</h3>
            <p>Refinar proporciones, contraste, textura y consistencia.</p>
          </article>
        </div>
      </section>

      <section class="design-signature reveal">
        <div class="signature-image">
          <img src="/assets/diseno/Banner%202.png" alt="Pieza gráfica PRØYET_RED" loading="lazy" />
        </div>

        <div class="signature-copy">
          <span class="section-kicker">PRØYET_RED / DESIGN</span>
          <h2>IDEAS QUE<br /><em>SE CONVIERTEN.</em></h2>
          <p>
            Diseño gráfico, identidad y dirección visual con una mirada
            contemporánea y digital.
          </p>
          <a href="#contacto" class="inline-link">INICIAR PROYECTO <span>↗</span></a>
        </div>
      </section>

      <section class="contact-section" id="contacto">
        <div class="contact-shell reveal">
          <div class="contact-left">
            <span class="section-kicker">CONTACT / PRØYET_RED</span>
            <h2>¿TRABAJAMOS<br /><em>JUNTOS?</em></h2>
            <p>
              Si tienes una identidad, campaña o pieza que necesita dirección visual,
              podemos convertir la idea en algo concreto.
            </p>

            <a 
              class="button button-primary magnetic" 
              href="https://wa.me/584122791704?text=Hola%20David,%20me%20gustar%C3%ADa%20hablar%20contigo%20sobre%20un%20proyecto." 
              target="_blank" 
              rel="noopener noreferrer"
            >
              <span>HABLEMOS</span>
              <b>↗</b>
            </a>
          </div>

          <div class="contact-right">
            <img src="/assets/images/Logo.png" alt="NERAEL" />
            <strong>NERAEL</strong>
            <span>SOFTWARE · DESIGN · EDITION</span>
            <span>MARACAIBO · VENEZUELA</span>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-main">
        <div class="footer-brand">
          <a href="/" class="footer-logo">
            <span class="brand-mark">
              <img src="/assets/images/Logo.png" alt="" />
            </span>
            <span>PRØYET_RED</span>
          </a>
          <p>
            Desarrollo, diseño y dirección visual desde una misma visión creativa.
          </p>
        </div>

        <div class="footer-column">
          <span class="footer-title">NAVEGACIÓN</span>
          <a href="/">Inicio</a>
          <a href="/proyectos">Proyectos</a>
          <a href="/diseno">Diseño</a>
          <a href="/edicion">Edición</a>
          <a href="/sobre-mi">Sobre mí</a>
        </div>

        <div class="footer-column">
          <span class="footer-title">ÁREAS</span>
          <span>Branding</span>
          <span>Diseño gráfico</span>
          <span>Dirección visual</span>
          <span>Desarrollo web</span>
        </div>

        <div class="footer-column">
          <span class="footer-title">REDES</span>
          <a href="https://github.com/neraelm-m" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a href="https://wa.me/584122791704" target="_blank" rel="noopener noreferrer">WhatsApp ↗</a>
          <a href="mailto:nerael.m@gmail.com">Email ↗</a>
        </div>
      </div>

      <div class="footer-bottom">
        <span>PRØYET_RED © 2026</span>
        <span>DAVID MARTINEZ</span>
        <span>MARACAIBO · VENEZUELA</span>
      </div>
    </footer>

    <a
      class="whatsapp-float"
      href="https://wa.me/584122791704"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contactar por WhatsApp"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.52 3.48A11.82 11.82 0 0 0 12.08 0C5.54 0 .22 5.32.22 11.86c0 2.09.55 4.13 1.59 5.93L.12 24l6.35-1.66a11.86 11.86 0 0 0 5.61 1.43h.01c6.54 0 11.86-5.32 11.86-11.86 0-3.17-1.23-6.15-3.43-8.43ZM12.09 21.8h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.77.99 1.01-3.68-.23-.38a9.87 9.87 0 0 1-1.51-5.28C2.19 6.41 6.63 1.97 12.09 1.97c2.65 0 5.14 1.03 7.01 2.91a9.85 9.85 0 0 1 2.9 7.02c0 5.46-4.44 9.9-9.91 9.9Zm5.43-7.42c-.3-.15-1.77-.87-2.05-.97-.28-.1-.49-.15-.7.15-.21.31-.8.97-.98 1.17-.18.21-.36.23-.66.08-.3-.15-1.27-.47-2.42-1.5-.9-.8-1.5-1.78-1.68-2.08-.18-.31-.02-.47.13-.62.13-.13.3-.36.45-.54.15-.18.2-.31.3-.51.1-.2.05-.38-.03-.53-.08-.15-.7-1.69-.96-2.32-.25-.61-.51-.53-.7-.54h-.6c-.21 0-.54.08-.82.38-.28.31-1.07 1.04-1.07 2.54s1.1 2.95 1.25 3.16c.15.2 2.16 3.3 5.23 4.63.73.31 1.3.49 1.74.63.73.23 1.39.2 1.92.12.59-.09 1.77-.72 2.02-1.41.25-.69.25-1.28.18-1.4-.08-.13-.28-.2-.58-.36Z"/>
      </svg>
    </a>
  </div>
</Layout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #050505;
    color: #f4f1ef;
    font-family: Arial, Helvetica, sans-serif;
    overflow-x: hidden;
  }

  :global(*) {
    box-sizing: border-box;
  }

  .site-shell {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(circle at 70% 12%, rgba(150, 0, 20, 0.16), transparent 32%),
      #050505;
  }

  .ambient,
  .grid-bg,
  .noise,
  .vignette {
    position: fixed;
    inset: 0;
    pointer-events: none;
  }

  .ambient {
    z-index: 0;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.42;
  }

  .ambient-one {
    width: 38vw;
    height: 38vw;
    top: -18vw;
    right: -10vw;
    background: rgba(180, 0, 30, 0.2);
  }

  .ambient-two {
    width: 28vw;
    height: 28vw;
    left: -15vw;
    top: 48%;
    background: rgba(130, 0, 18, 0.13);
  }

  .ambient-three {
    width: 24vw;
    height: 24vw;
    right: 4%;
    bottom: -12vw;
    background: rgba(255, 35, 55, 0.08);
  }

  .grid-bg {
    z-index: 0;
    opacity: 0.08;
    background-image:
      linear-gradient(rgba(255,255,255,.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.08) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: linear-gradient(to bottom, black, transparent 85%);
  }

  .noise {
    z-index: 50;
    opacity: 0.035;
    background-image: url("/assets/images/wallpaper8.jpg");
    background-size: 700px;
    mix-blend-mode: screen;
  }

  .vignette {
    z-index: 49;
    box-shadow: inset 0 0 180px rgba(0,0,0,.72);
  }

  .cursor-light {
    position: fixed;
    z-index: 4;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    pointer-events: none;
    background: radial-gradient(circle, rgba(255, 30, 50, 0.09), transparent 68%);
    transform: translate(-50%, -50%);
    transition: opacity .25s ease;
  }

  .scroll-progress {
    position: fixed;
    z-index: 100;
    top: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: #e3263f;
    box-shadow: 0 0 14px rgba(227,38,63,.75);
  }

  .site-header {
    position: sticky;
    z-index: 90;
    top: 0;
    padding: 15px 4vw;
    border-bottom: 1px solid rgba(255,255,255,.08);
    background: rgba(5,5,5,.66);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .header-inner {
    max-width: 1440px;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .brand,
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-decoration: none;
  }

  .brand-mark {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .brand-mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .brand-name {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .14em;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 25px;
  }

  .desktop-nav a {
    position: relative;
    color: rgba(255,255,255,.58);
    text-decoration: none;
    font-size: 10px;
    letter-spacing: .12em;
    transition: color .2s ease;
  }

  .desktop-nav a:hover,
  .desktop-nav a.active {
    color: #fff;
  }

  .desktop-nav a.active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -7px;
    height: 1px;
    background: #e3263f;
    box-shadow: 0 0 10px rgba(227,38,63,.7);
  }

  .desktop-nav .nav-contact {
    padding-left: 25px;
    border-left: 1px solid rgba(255,255,255,.12);
    color: #fff;
  }

  .menu-toggle {
    display: none;
    width: 40px;
    height: 40px;
    padding: 9px;
    border: 1px solid rgba(255,255,255,.15);
    border-radius: 10px;
    background: rgba(255,255,255,.04);
  }

  .menu-toggle span {
    display: block;
    width: 100%;
    height: 1px;
    margin: 6px 0;
    background: #fff;
  }

  .mobile-menu {
    display: none;
  }

  main,
  .site-footer {
    position: relative;
    z-index: 5;
  }

  .design-hero {
    max-width: 1440px;
    min-height: 680px;
    margin: auto;
    padding: 92px 4vw 95px;
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    align-items: center;
    gap: clamp(45px, 7vw, 110px);
  }

  .eyebrow,
  .media-topline,
  .frame-label,
  .section-kicker,
  .section-index,
  .card-number,
  .footer-title,
  .mobile-menu-footer {
    font-family: "Courier New", monospace;
    text-transform: uppercase;
    letter-spacing: .1em;
    font-size: 9px;
    color: rgba(255,255,255,.45);
  }

  .eyebrow {
    display: flex;
    justify-content: space-between;
    max-width: 520px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(255,255,255,.12);
  }

  .hero-copy h1 {
    margin: 26px 0 20px;
    max-width: 850px;
    font-size: clamp(58px, 8.2vw, 126px);
    line-height: .82;
    letter-spacing: -.065em;
    font-weight: 800;
  }

  h1 em,
  h2 em {
    color: #e3263f;
    font-style: normal;
  }

  .hero-description {
    max-width: 540px;
    margin: 0;
    color: rgba(255,255,255,.62);
    font-size: 16px;
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }

  .button {
    min-height: 45px;
    padding: 0 17px;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    border: 1px solid rgba(255,255,255,.15);
    border-radius: 12px;
    color: #fff;
    text-decoration: none;
    font-size: 9px;
    letter-spacing: .13em;
    transition: transform .25s ease, background .25s ease, border-color .25s ease;
  }

  .button:hover {
    transform: translateY(-3px);
    border-color: rgba(227,38,63,.65);
  }

  .button-primary {
    background: rgba(227,38,63,.88);
    border-color: rgba(227,38,63,.9);
  }

  .button-ghost {
    background: rgba(255,255,255,.035);
    backdrop-filter: blur(12px);
  }

  .hero-visual {
    position: relative;
  }

  .hero-frame {
    position: relative;
    min-height: 470px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.13);
    border-radius: 28px;
    background: rgba(255,255,255,.045);
    box-shadow: inset 0 0 80px rgba(255,255,255,.02), 0 35px 100px rgba(0,0,0,.4);
    backdrop-filter: blur(16px);
  }

  .hero-frame::before {
    content: "";
    position: absolute;
    inset: 16px;
    border: 1px solid rgba(227,38,63,.2);
    border-radius: 20px;
  }

  .hero-frame img {
    position: relative;
    z-index: 2;
    width: 58%;
    max-height: 330px;
    object-fit: contain;
    filter: drop-shadow(0 20px 35px rgba(0,0,0,.65));
    transform: translateZ(0);
  }

  .frame-label {
    position: absolute;
    z-index: 3;
    left: 24px;
    right: 24px;
    display: flex;
    justify-content: space-between;
  }

  .frame-label-top {
    top: 23px;
  }

  .frame-label-bottom {
    bottom: 23px;
  }

  .hero-orbit {
    position: absolute;
    width: 155px;
    height: 155px;
    right: -48px;
    top: -42px;
    border: 1px solid rgba(227,38,63,.35);
    border-radius: 50%;
    opacity: .7;
  }

  .hero-orbit span {
    position: absolute;
    width: 7px;
    height: 7px;
    top: 18px;
    left: 22px;
    border-radius: 50%;
    background: #e3263f;
    box-shadow: 0 0 15px rgba(227,38,63,.8);
  }

  .hero-orbit span:last-child {
    top: auto;
    left: auto;
    right: 12px;
    bottom: 28px;
  }

  .statement {
    max-width: 1440px;
    margin: auto;
    padding: 30px 4vw 100px;
    display: grid;
    grid-template-columns: .35fr 1fr;
    gap: 50px;
  }

  .statement-copy {
    max-width: 820px;
  }

  .statement-copy p {
    margin: 0;
    font-size: clamp(26px, 3.5vw, 51px);
    line-height: 1.08;
    letter-spacing: -.035em;
  }

  .work-section,
  .services-section,
  .process-section {
    max-width: 1440px;
    margin: auto;
    padding: 90px 4vw;
  }

  .section-heading {
    display: grid;
    grid-template-columns: 1fr .55fr;
    align-items: end;
    gap: 50px;
    margin-bottom: 45px;
  }

  .section-heading.compact {
    grid-template-columns: 1fr;
  }

  .section-heading h2,
  .services-intro h2 {
    margin: 12px 0 0;
    font-size: clamp(45px, 6vw, 82px);
    line-height: .9;
    letter-spacing: -.055em;
  }

  .section-heading h2 span {
    color: #e3263f;
  }

  .section-heading > p,
  .services-intro p {
    margin: 0;
    color: rgba(255,255,255,.5);
    line-height: 1.65;
    font-size: 13px;
  }

  .design-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    align-items: start;
  }

  .design-card {
    min-width: 0;
  }

