---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";

const technologies = [
  {
    number: "01",
    title: "DESARROLLO",
    items: ["HTML5", "CSS3", "JavaScript", "TypeScript", "Astro", "Tailwind CSS", "APIs", "Git", "GitHub"],
  },
  {
    number: "02",
    title: "PRODUCTO DIGITAL",
    items: ["Interfaces", "Responsive UI", "Arquitectura", "Automatización", "Prototipado", "Experiencia de usuario"],
  },
  {
    number: "03",
    title: "DISEÑO",
    items: ["Diseño gráfico", "Branding", "Dirección visual", "UI/UX", "Edición de vídeo", "Motion"],
  },
];

const facts = [
  ["PERFIL", "Desarrollador de Software"],
  ["FORMACIÓN", "Técnico en Computación"],
  ["BASE", "Maracaibo · Venezuela"],
  ["ESTUDIO", "PRØYET_RED · 2026—"],
];
---

<Layout
  title="Sobre mí · David Martinez, Desarrollador de Software | NERAEL"
  description="Soy David Martinez (NERAEL), desarrollador de software en Maracaibo, Venezuela. Combino programación, diseño y dirección visual en PRØYET_RED."
>
  <main class="site-shell">
    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>
    <div class="ambient ambient-three"></div>
    <div class="grid-bg"></div>
    <div class="noise"></div>
    <div class="vignette"></div>

    <SiteHeader active="sobre-mi" />

    <section class="hero section">
      <div class="hero-copy reveal">
        <div class="eyebrow">
          <span class="eyebrow-dot"></span>
          SOBRE MÍ · PERFIL
        </div>

        <h1>
          <span>DAVID</span>
          <strong>MARTINEZ</strong>
        </h1>

        <div class="hero-line">
          <span></span>
          <p>SOFTWARE · DESIGN · DIGITAL</p>
        </div>

        <p class="hero-description">
          Desarrollador de software con una forma de trabajo que combina lógica,
          producto y lenguaje visual para construir experiencias digitales funcionales
          y reconocibles.
        </p>
      </div>

      <div class="hero-portrait reveal reveal-delay">
        <div class="portrait-frame">
          <img src="/assets/images/perfil.jpg" alt="David Martinez" />
          <div class="portrait-overlay"></div>
          <span class="portrait-tag">NERAEL</span>
          <span class="portrait-index">01 / 04</span>
        </div>
        <div class="portrait-caption">
          <span>MARACAIBO · VENEZUELA</span>
          <span>AVAILABLE FOR WORK</span>
        </div>
      </div>
    </section>

    <section class="about section">
      <div class="section-heading reveal">
        <span class="section-number">01</span>
        <div>
          <span class="section-kicker">PERFIL</span>
          <h2>UNA MEZCLA DE<br /><em>LÓGICA Y VISIÓN.</em></h2>
        </div>
      </div>

      <div class="about-layout">
        <div class="about-image reveal">
          <img src="/assets/images/wallpaper2.webp" alt="Composición visual de PRØYET_RED" loading="lazy" decoding="async" />
          <div class="image-label">PRØYET_RED / 2026</div>
        </div>

        <div class="about-copy reveal reveal-delay">
          <p class="lead">
            Soy David Martinez, desarrollador de software con una forma de trabajo
            que combina lógica, producto y lenguaje visual.
          </p>

          <p>
            Trabajo en desarrollo web, aplicaciones, automatización y construcción
            de experiencias digitales. Paralelamente desarrollo proyectos de diseño
            gráfico, edición y dirección visual bajo <strong>PRØYET_RED</strong>.
          </p>

          <p>
            Mi enfoque parte de entender el problema, ordenar la experiencia y
            convertirla en una solución funcional, reconocible y cuidada hasta el
            último detalle. Me interesa que la tecnología no solo funcione, sino que
            también tenga una identidad propia.
          </p>

          <p>
            Desarrollo interfaces, sistemas y productos digitales pensando tanto en
            la parte técnica como en la forma en que una persona los utiliza.
            También exploro herramientas de inteligencia artificial y nuevas formas
            de crear experiencias digitales.
          </p>
        </div>
      </div>

      <div class="facts-grid reveal">
        {facts.map(([label, value]) => (
          <div class="fact">
            <span>{label}</span>
            <strong>{value}</strong>
          </div>
