---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";

const videos = [
  {
    id: "01",
    title: "VIDEO 01",
    video: "/assets/videos/video01.mp4",
    poster: "/assets/thumbnails/video01.jpg",
  },
  {
    id: "02",
    title: "VIDEO 02",
    video: "/assets/videos/video02.mp4",
    poster: "/assets/thumbnails/video02.jpg",
  },
  {
    id: "03",
    title: "VIDEO 03",
    video: "/assets/videos/video03.mp4",
    poster: "/assets/thumbnails/video03.jpg",
  },
  {
    id: "04",
    title: "VIDEO 04",
    video: "/assets/videos/video04.mp4",
    poster: "/assets/thumbnails/video04.png",
  },
];

const email = "mailto:nerael.m@gmail.com";
const whatsapp = "https://wa.me/584122791704";
---

<Layout
  title="Edición · NERAEL"
  description="Edición de vídeo, motion y trabajos audiovisuales de David Martinez."
>
  <main class="page">
    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>
    <div class="grid"></div>
    <div class="noise"></div>
    <div class="vignette"></div>

    <div class="scroll-progress" id="scrollProgress"></div>
    <div class="cursor-light" id="cursorLight"></div>

    <SiteHeader active="edicion" />

    <section class="hero section-pad">
      <div class="hero-copy reveal">
        <div class="eyebrow-row">
          <span>SELECTED MEDIA</span>
          <span>04 / 04</span>
        </div>

        <h1>
          EDICIÓN
          <span>DE VÍDEO.</span>
        </h1>

        <p class="hero-text">
          Edición, ritmo, composición y movimiento para convertir material
          audiovisual en piezas con una identidad visual propia.
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="#trabajos">
            VER TRABAJOS <span>↘</span>
          </a>

          <a class="button" href="#contacto">
            HABLEMOS <span>↗</span>
          </a>
        </div>
      </div>

      <div class="hero-side reveal">
        <div
          class="hero-card reel-card"
          data-reel
          data-clips={JSON.stringify(videos)}
        >
          <video
            class="reel-video"
            data-reel-video
            autoplay
            muted
            playsinline
            preload="auto"
            poster={videos[0].poster}
            aria-label="Selección de vídeos de PRØYET_RED"
          >
            <source src={videos[0].video} type="video/mp4" />
          </video>

          <div class="reel-overlay"></div>

          <div class="reel-top">
            <span>PRØYET_RED</span>
            <span data-reel-counter>01 / 04</span>
          </div>

          <div class="reel-center">
            <span class="reel-play">▶</span>
            <strong>MOTION</strong>
            <small>SELECTED MEDIA / REEL</small>
          </div>

          <div class="reel-bottom">
            <span data-reel-title>VIDEO 01</span>
            <div class="reel-dots" data-reel-dots>
              {videos.map((item, index) => (
                <i class:list={{ active: index === 0 }}></i>
              ))}
            </div>
          </div>

          <div class="reel-progress">
            <span data-reel-progress></span>
          </div>
        </div>
      </div>
    </section>

    <section class="intro section-pad reveal" id="trabajos">
      <div class="section-label">
        <span>01</span>
        <span>VIDEO / MOTION / EDIT</span>
      </div>

      <div class="intro-grid">
        <h2>
          IMÁGENES<br />
          <span>EN MOVIMIENTO.</span>
        </h2>

        <p>
          Una selección de trabajos audiovisuales editados dentro de
          PRØYET_RED. Cada pieza utiliza ritmo, imagen, sonido y composición
          para construir una experiencia visual.
        </p>
      </div>
    </section>

    <section class="works section-pad">
      <div class="works-head reveal">
        <div>
          <span class="micro">ARCHIVE / 2026</span>
          <h2>TRABAJOS.</h2>
        </div>

        <span class="works-count">04 PIEZAS</span>
      </div>

      <div class="video-grid">
        {
          videos.map((item, index) => (
            <article class:list={["video-card", index === 0 && "video-featured", "reveal"]}>
              <div class="video-frame">
                <video
                  controls
                  preload="metadata"
                  playsinline
                  poster={item.poster}
                >
                  <source src={item.video} type="video/mp4" />
                  Tu navegador no puede reproducir este vídeo.
                </video>

                <div class="video-index">{item.id}</div>
              </div>

              <div class="video-info">
                <div>
                  <span>VIDEO / EDITION</span>
                  <h3>{item.title}</h3>
                </div>

                <span class="video-arrow">↗</span>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="statement section-pad reveal">
      <span class="micro">PRØYET_RED / EDITION</span>

      <h2>
        EL RITMO TAMBIÉN
        <span>CUENTA UNA HISTORIA.</span>
      </h2>

      <p>
        Cortes, transiciones, sonido, color y movimiento trabajando como una
        sola pieza visual.
      </p>
    </section>

    <section class="services section-pad">
      <div class="section-label reveal">
        <span>02</span>
        <span>CAPABILITIES</span>
      </div>

      <div class="services-grid">
        <article class="service reveal">
          <span>01</span>
          <h3>EDICIÓN</h3>
          <p>
            Selección, montaje y ritmo para construir una pieza coherente.
          </p>
        </article>

        <article class="service reveal">
          <span>02</span>
          <h3>MOTION</h3>
          <p>
            Movimiento, títulos y recursos gráficos para reforzar la narrativa.
          </p>
        </article>

        <article class="service reveal">
          <span>03</span>
          <h3>DIRECCIÓN VISUAL</h3>
          <p>
            Composición, color y lenguaje visual aplicado al contenido
            audiovisual.
          </p>
        </article>

        <article class="service reveal">
          <span>04</span>
          <h3>CONTENIDO</h3>
          <p>
            Piezas pensadas para redes, proyectos digitales y comunicación
            visual.
          </p>
        </article>
      </div>
    </section>

    <section class="signature section-pad reveal">
      <div class="signature-shell">
        <div class="signature-copy">
          <span class="micro">PRØYET_RED / AUDIOVISUAL</span>

          <h2>
            EDITAR ES<br />
            <span>CONSTRUIR.</span>
          </h2>

          <p>
            Una buena edición no solo une imágenes. Define el ritmo, dirige
            la atención y convierte material en una experiencia.
          </p>
        </div>

        <div class="signature-mark">
          <img src="/assets/images/logo2.png" alt="PRØYET_RED" />
          <span>SOFTWARE · DESIGN · EDITION</span>
        </div>
      </div>
    </section>

    <section class="contact section-pad reveal" id="contacto">
      <div class="contact-shell">
        <div class="contact-main">
          <span class="micro">CONTACT / PRØYET_RED</span>

          <h2>
            ¿TRABAJAMOS<br />
            <span>JUNTOS?</span>
          </h2>

          <p>
            Si tienes un vídeo, campaña o pieza audiovisual que necesita
            edición y dirección visual, podemos convertir la idea en algo
            concreto.
          </p>

          <a class="contact-button" href={email}>
            nerael.m@gmail.com <span>↗</span>
          </a>
        </div>

        <div class="contact-brand">
          <img src="/assets/images/Logo.png" alt="PRØYET_RED" />
          <strong>NERAEL</strong>
          <span>SOFTWARE · DESIGN · EDITION</span>
          <span>MARACAIBO · VENEZUELA</span>
        </div>
      </div>
    </section>

    <footer class="footer">
      <div class="footer-main">
        <div class="footer-brand">
          <a href="/" class="footer-logo">
            <img src="/assets/images/Logo.png" alt="" />
            <span>PRØYET_RED</span>
          </a>

          <p>
            Desarrollo, diseño y edición bajo una dirección visual propia.
          </p>
        </div>

        <div class="footer-column">
          <span>NAVEGACIÓN</span>
          <a href="/">Inicio</a>
          <a href="/proyectos">Proyectos</a>
          <a href="/diseno">Diseño</a>
          <a href="/edicion">Edición</a>
          <a href="/sobre-mi">Sobre mí</a>
        </div>

        <div class="footer-column">
          <span>ÁREAS</span>
          <a href="/proyectos">Desarrollo</a>
          <a href="/diseno">Diseño gráfico</a>
          <a href="/edicion">Edición</a>
          <a href="/edicion">Motion</a>
        </div>

        <div class="footer-column">
          <span>REDES</span>
          <a
            href="https://github.com/neraelm-m"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub ↗
          </a>
          <a
            href={whatsapp}
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp ↗
          </a>
        </div>
      </div>

      <div class="footer-bottom">
        <span>PRØYET_RED © 2026</span>
        <span>DAVID MARTINEZ</span>
        <span>MARACAIBO · VENEZUELA</span>
      </div>
    </footer>

    <a
      class="whatsapp"
      href={whatsapp}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contactar por WhatsApp"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.5 0 .2 5.3.2 11.9c0 2.1.6 4.1 1.6 5.9L.1 24l6.4-1.7a11.8 11.8 0 0 0 5.6 1.4h.1c6.6 0 11.9-5.3 11.9-11.9 0-3.2-1.3-6.1-3.6-8.3Zm-8.3 18.2h-.1c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.8 1 1-3.7-.2-.4a9.8 9.8 0 0 1-1.5-5.2C2.2 6.4 6.6 2 12.1 2c2.7 0 5.1 1 7 2.9s2.9 4.3 2.9 7c0 5.4-4.4 9.8-9.8 9.8Zm5.4-7.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-1.8-.9-3-1.6-4.2-3.6-.3-.5.3-.5.8-1.6.1-.2 0-.4 0-.5l-.9-2.1c-.2-.5-.5-.4-.7-.4h-.6c-.2 0-.5.1-.8.4-.3.3-1.1 1.1-1.1 2.6s1.1 3 1.2 3.2c.1.2 2.2 3.4 5.4 4.8 2 .9 2.8 1 3.8.8.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.1-.3-.2-.7-.4Z"/>
      </svg>
    </a>
  </main>
</Layout>

<style>
  :global(html) {
    scroll-behavior: smooth;
    background: #050505;
  }

  :global(body) {
    margin: 0;
    background: #050505;
    color: #f3f1f0;
    font-family: Arial, Helvetica, sans-serif;
  }

  :global(*) {
    box-sizing: border-box;
  }

  .page {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(circle at 12% 12%, rgba(210, 20, 50, 0.14), transparent 32%),
      radial-gradient(circle at 88% 48%, rgba(230, 30, 55, 0.08), transparent 30%),
      #050505;
  }

  .ambient,
  .grid,
  .noise,
  .vignette {
    position: fixed;
    inset: 0;
    pointer-events: none;
  }

  .ambient-one {
    background: radial-gradient(circle at 18% 30%, rgba(218, 27, 51, 0.11), transparent 26%);
    filter: blur(30px);
  }

  .ambient-two {
    background: radial-gradient(circle at 78% 72%, rgba(170, 12, 38, 0.08), transparent 25%);
    filter: blur(45px);
  }

  .grid {
    opacity: 0.08;
    background-image:
      linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px);
    background-size: 70px 70px;
  }

  .noise {
    opacity: 0.025;
    background-image: url("/assets/images/wallpaper8.jpg");
    background-size: 700px auto;
    mix-blend-mode: screen;
  }

  .vignette {
    box-shadow: inset 0 0 180px rgba(0,0,0,.72);
  }

  .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    width: 0;
    height: 2px;
    background: #ed233f;
  }

  .cursor-light {
    position: fixed;
    z-index: 2;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    pointer-events: none;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(237,35,63,.08), transparent 68%);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 76px;
    padding: 0 4vw;
    border-bottom: 1px solid rgba(255,255,255,.08);
    background: rgba(5,5,5,.68);
    backdrop-filter: blur(22px);
    transition: background .3s ease, border-color .3s ease;
  }

  .site-header.scrolled {
    background: rgba(5,5,5,.88);
    border-color: rgba(237,35,63,.2);
  }

  .brand,
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: #fff;
    text-decoration: none;
    font-weight: 800;
    letter-spacing: .12em;
    font-size: 12px;
  }

  .brand-mark {
    width: 29px;
    height: 29px;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .brand-mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 29px;
  }

  .desktop-nav a {
    position: relative;
    color: rgba(255,255,255,.62);
    text-decoration: none;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .08em;
    transition: color .25s ease;
  }

  .desktop-nav a:hover,
  .desktop-nav a.active {
    color: #fff;
  }

  .desktop-nav a.active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -9px;
    height: 1px;
    background: #ed233f;
  }

  .desktop-nav .nav-contact {
    margin-left: 5px;
    color: #fff;
  }

  .menu-toggle {
    display: none;
    width: 42px;
    height: 42px;
    border: 1px solid rgba(255,255,255,.15);
    border-radius: 12px;
    background: rgba(255,255,255,.03);
  }

  .menu-toggle span {
    display: block;
    width: 18px;
    height: 1px;
    margin: 5px auto;
    background: #fff;
  }

  .mobile-menu {
    display: none;
  }

  .section-pad {
    width: min(1240px, calc(100% - 8vw));
    margin: 0 auto;
  }

  .hero {
    min-height: 700px;
    display: grid;
    grid-template-columns: 1.45fr .75fr;
    align-items: center;
    gap: 70px;
    padding-top: 90px;
    padding-bottom: 90px;
  }

  .eyebrow-row,
  .section-label,
  .card-top,
  .card-bottom,
  .micro,
  .works-count {
    color: rgba(255,255,255,.46);
    font-family: "Courier New", monospace;
    font-size: 9px;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .eyebrow-row,
  .section-label {
    display: flex;
    justify-content: space-between;
    padding-bottom: 17px;
    border-bottom: 1px solid rgba(255,255,255,.12);
  }

  .hero h1 {
    margin: 28px 0 22px;
    max-width: 900px;
    font-size: clamp(70px, 9vw, 145px);
    line-height: .82;
    letter-spacing: -.07em;
    font-weight: 900;
  }

  .hero h1 span,
  .intro h2 span,
  .statement h2 span,
  .signature h2 span,
  .contact h2 span {
    color: #ed233f;
  }

  .hero-text {
    max-width: 610px;
    color: rgba(255,255,255,.64);
    font-size: 15px;
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    gap: 10px;
    margin-top: 30px;
  }

  .button,
  .contact-button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 35px;
    min-width: 132px;
    padding: 14px 16px;
    border: 1px solid rgba(255,255,255,.18);
    border-radius: 12px;
    color: #fff;
    text-decoration: none;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .04em;
    background: rgba(255,255,255,.035);
    transition: transform .25s ease, background .25s ease, border-color .25s ease;
  }

  .button:hover,
  .contact-button:hover {
    transform: translateY(-2px);
    border-color: rgba(237,35,63,.55);
    background: rgba(237,35,63,.09);
  }

  .button-primary {
    background: #c91c37;
    border-color: #c91c37;
  }


  .reel-card {
    position: relative;
    min-height: 470px;
    overflow: hidden;
    isolation: isolate;
    padding: 0;
    background: #080808;
  }

  .reel-video {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #050505;
  }

  .reel-overlay {
    position: absolute;
    z-index: 1;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(0,0,0,.55), transparent 28%, transparent 62%, rgba(0,0,0,.7)),
      linear-gradient(135deg, rgba(237,35,63,.16), transparent 45%);
    pointer-events: none;
  }

  .reel-top,
  .reel-bottom {
    position: absolute;
    z-index: 3;
    left: 22px;
    right: 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: rgba(255,255,255,.65);
    font: 8px "Courier New", monospace;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .reel-top {
    top: 20px;
  }

  .reel-bottom {
    bottom: 19px;
  }

  .reel-center {
    position: absolute;
    z-index: 3;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
    pointer-events: none;
  }

  .reel-play {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    padding-left: 3px;
    border: 1px solid rgba(237,35,63,.65);
    border-radius: 50%;
    color: #ed233f;
    background: rgba(0,0,0,.28);
    backdrop-filter: blur(8px);
  }

  .reel-center strong {
    font-size: 24px;
    letter-spacing: .05em;
  }

  .reel-center small {
    color: rgba(255,255,255,.42);
    font: 8px "Courier New", monospace;
    letter-spacing: .14em;
  }

  .reel-dots {
    display: flex;
    gap: 5px;
  }

  .reel-dots i {
    width: 18px;
    height: 2px;
    background: rgba(255,255,255,.25);
    transition: width .25s ease, background .25s ease;
  }

  .reel-dots i.active {
    width: 30px;
    background: #ed233f;
  }

  .reel-progress {
    position: absolute;
    z-index: 4;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: rgba(255,255,255,.1);
  }

  .reel-progress span {
    display: block;
    width: 0;
    height: 100%;
    background: #ed233f;
  }

  @media (max-width: 560px) {
    .reel-card {
      min-height: 300px;
      border-radius: 22px;
    }
  }

  .hero-card {
    min-height: 470px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px;
    border: 1px solid rgba(255,255,255,.13);
    border-radius: 28px;
    background: linear-gradient(145deg, rgba(255,255,255,.055), rgba(255,255,255,.015));
    backdrop-filter: blur(18px);
    box-shadow: inset 0 0 50px rgba(237,35,63,.035);
  }

  .card-top,
  .card-bottom {
    display: flex;
    justify-content: space-between;
  }

  .hero-card-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 9px;
    text-align: center;
  }

  .play-symbol {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    padding-left: 4px;
    border: 1px solid rgba(237,35,63,.5);
    border-radius: 50%;
    color: #ed233f;
    font-size: 18px;
    box-shadow: 0 0 45px rgba(237,35,63,.1);
  }

  .hero-card-center strong {
    font-size: 26px;
    letter-spacing: .05em;
  }

  .hero-card-center small {
    color: rgba(255,255,255,.42);
    font: 9px "Courier New", monospace;
    letter-spacing: .15em;
  }

  .intro {
    padding-top: 70px;
    padding-bottom: 80px;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1fr .75fr;
    gap: 90px;
    padding-top: 48px;
  }

  .intro h2,
  .statement h2,
  .signature h2 {
    margin: 0;
    font-size: clamp(48px, 6vw, 88px);
    line-height: .9;
    letter-spacing: -.06em;
  }

  .intro p,
  .statement p,
  .signature p {
    margin: 0;
    max-width: 560px;
    color: rgba(255,255,255,.56);
    line-height: 1.7;
    font-size: 14px;
  }

  .works {
    padding-top: 50px;
    padding-bottom: 95px;
  }

  .works-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    padding-bottom: 28px;
    border-bottom: 1px solid rgba(255,255,255,.1);
  }

  .works-head h2 {
    margin: 9px 0 0;
    font-size: clamp(45px, 6vw, 78px);
